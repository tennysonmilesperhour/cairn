# Overpass. The default endpoint is overpass-api.de. Mirrors are worth trying
# when the main instance is over quota, for example
# https://overpass.kumi.systems/api/interpreter
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=300

# Copernicus GLO-30 DEM. Public AWS open data bucket, no credentials needed.
# Tiles are cached under data/dem/ after first use.
COPERNICUS_DEM_BASE=https://copernicus-dem-30m.s3.amazonaws.com

# Supabase Postgres connection string. Only needed for ingest.py --write-supabase.
# Get it from Supabase project settings, Database, Connection string, URI.
# Use a development project until the ingest output has been reviewed.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Public URL of the region pmtiles archive on Cloudflare R2. Not produced until
# phase 2. The regions row needs a non-null value, so leave this blank until then.
PMTILES_URL=
